{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbitrium.invalid/contracts/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "arbitrium.result.v1"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "choice",
            "binary",
            "ordinal"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "abstain",
        "error"
      ]
    },
    "verdict": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "probabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "label",
          "probability"
        ]
      },
      "maxItems": 16
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "answerability": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "enum": [
        null,
        "low_answerability",
        "low_confidence",
        "release_gate_not_met"
      ]
    },
    "calibration_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported_schema",
                "unsupported_task",
                "unsupported_language",
                "invalid_choices",
                "question_mismatch",
                "input_too_long",
                "artifact_invalid",
                "artifact_incompatible",
                "calibration_missing",
                "resource_exhausted",
                "nonfinite_output",
                "cancelled",
                "deadline_exceeded",
                "io_error",
                "internal_error"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "code",
            "retryable",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "artifact_id",
    "kind",
    "status",
    "verdict",
    "probabilities",
    "score",
    "confidence",
    "answerability",
    "reason_code",
    "calibration_id",
    "error"
  ],
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "ok"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "kind": {
          "enum": [
            "choice",
            "binary",
            "ordinal"
          ]
        },
        "verdict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "probabilities": {
          "minItems": 2
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "answerability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason_code": {
          "type": "null"
        },
        "error": {
          "type": "null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ordinal"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "properties": {
        "status": {
          "const": "abstain"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "kind": {
          "enum": [
            "choice",
            "binary",
            "ordinal"
          ]
        },
        "verdict": {
          "type": "null"
        },
        "probabilities": {
          "minItems": 2
        },
        "score": {
          "type": "null"
        },
        "confidence": {
          "type": "null"
        },
        "answerability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason_code": {
          "enum": [
            "low_answerability",
            "low_confidence",
            "release_gate_not_met"
          ]
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "error"
        },
        "verdict": {
          "type": "null"
        },
        "probabilities": {
          "maxItems": 0
        },
        "score": {
          "type": "null"
        },
        "confidence": {
          "type": "null"
        },
        "answerability": {
          "type": "null"
        },
        "reason_code": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported_schema",
                "unsupported_task",
                "unsupported_language",
                "invalid_choices",
                "question_mismatch",
                "input_too_long",
                "artifact_invalid",
                "artifact_incompatible",
                "calibration_missing",
                "resource_exhausted",
                "nonfinite_output",
                "cancelled",
                "deadline_exceeded",
                "io_error",
                "internal_error"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "code",
            "retryable",
            "message"
          ]
        }
      }
    }
  ]
}
